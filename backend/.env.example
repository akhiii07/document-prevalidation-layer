# Copy to backend/.env and adjust. Never commit the real .env.

APP_ENV=local
DEBUG=false

# --- Database ---------------------------------------------------------------
# Default (no value needed): file-backed SQLite at backend/var/docverify.db
# For Postgres parity, start it with `docker compose up -d db` and uncomment:
# DATABASE_URL=postgresql+psycopg://docverify:docverify@localhost:5432/docverify

# --- Storage ----------------------------------------------------------------
# STORAGE_DIR=./var/documents
SIGNED_URL_TTL_SECONDS=300

# --- Security ---------------------------------------------------------------
# Gates Operations endpoints. Prototype-grade (ADR-011) - change for any shared use.
OPS_SHARED_SECRET=dev-ops-secret-change-me
URL_SIGNING_KEY=dev-signing-key-change-me

# --- LLM --------------------------------------------------------------------
# Optional. With no key the deterministic fallback provider is used and every
# test still passes (ADR-010). The LLM never decides a verdict.
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5
LLM_ENABLED=true

# --- Frontend ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
